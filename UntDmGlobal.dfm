  object QryPermisos: TIBQuery
    Database = DbGlobal
    Transaction = TraBase
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'SELECT P.per_codi, p.per_opcion, p.usu_codi, p.per_leer,'
      'p.per_crear, p.per_modificar, p.per_borrar'
      'FROM permisos P'
      'WHERE P.usu_codi = :usu_codi'
      'ORDER BY P.usu_codi, P.per_opcion')
