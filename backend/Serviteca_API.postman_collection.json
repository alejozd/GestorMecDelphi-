        {
          "name": "Estadísticas Órdenes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ordenes/stats",
              "host": ["{{base_url}}"],
              "path": ["ordenes", "stats"]
            },
            "description": "Obtiene estadísticas de órdenes (totales por estado, ingresos, etc.)."
          },
          "response": []
        },
        {
          "name": "Obtener Orden por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ordenes/1",
              "host": ["{{base_url}}"],
              "path": ["ordenes", "1"]
            },
            "description": "Obtiene una orden específica con sus detalles."
          },
          "response": []
        },
        {
          "name": "Crear Orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otm_clase_doc\": 0,\n  \"cli_codi\": 1,\n  \"vxc_codi\": 1,\n  \"otm_kilometraje\": \"50000\",\n  \"otm_observacion\": \"Orden de prueba desde Postman\",\n  \"detalles\": [\n    {\n      \"pr_codi\": 11,\n      \"otd_cantidad\": 1,\n      \"otd_precio\": 150000,\n      \"emp_codi\": 1,\n      \"otd_observacion\": \"Mano de obra - Servicio básico\"\n    },\n    {\n      \"pr_codi\": 1,\n      \"otd_cantidad\": 4,\n      \"otd_precio\": 85000,\n      \"bod_codi\": 1,\n      \"otd_observacion\": \"Aceite de motor 5W30\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ordenes",
              "host": ["{{base_url}}"],
              "path": ["ordenes"]
            },
            "description": "Crea una nueva orden de trabajo con detalles."
          },
          "response": []
        },
        {
          "name": "Actualizar Orden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otm_observacion\": \"Orden actualizada desde Postman\",\n  \"detalles\": [\n    {\n      \"otd_cont\": 1,\n      \"pr_codi\": 11,\n      \"otd_cantidad\": 1,\n      \"otd_precio\": 150000,\n      \"otd_observacion\": \"Mano de obra actualizada\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ordenes/1",
              "host": ["{{base_url}}"],
