        {
          "name": "Finalizar Orden",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ordenes/1/finalizar",
              "host": ["{{base_url}}"],
              "path": ["ordenes", "1", "finalizar"]
            },
            "description": "Marca una orden como finalizada."
          },
          "response": []
        },
        {
          "name": "Anular Orden",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ordenes/1/anular",
              "host": ["{{base_url}}"],
              "path": ["ordenes", "1", "anular"]
            },
            "description": "Anula una orden (solo si está en proceso)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔍 Health Check",
      "item": [
        {
          "name": "Verificar API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifica que la API esté funcionando correctamente."
          },
          "response": []
        }
      ]
    }
  ]
}
